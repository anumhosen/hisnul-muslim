{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hisnul Muslim",
  "version": "1.0.0",
  "identifier": "com.anumhosen.hisnul-muslim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hisnul Muslim",
        "width": 1024,
        "height": 650,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "dmg"
    ],
    "publisher": "Anum Hosen",
    "copyright": "Copyright © 2026 Anum Hosen <anumhosen@gmail.com>",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/hisnulbd.db"
    ]
  }
}